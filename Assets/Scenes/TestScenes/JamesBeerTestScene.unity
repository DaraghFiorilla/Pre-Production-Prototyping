  m_Script: {fileID: 11500000, guid: 8285e3162a9f22844b4dfd0bd3f62980, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::AlcoCustomerDialogueQuiz
  correctProductType: Wine
  requiredAmount: 1
  currentAmount: 0
  tagText: 
  alcoholUICanvas: {fileID: 509487850}
  playerController: {fileID: 2004947781}
  QnA:
  - CustomerQuestion: Hey I'm looking for a specific type of drink I had at a dinner
      party last week, could you make youself useful and fetch it for me?
    PlayerQuestions:
    - Are you looking for some kind of beer?
    - Was it some kind of ale?
    - I'm gonna guess that it was some kind of wine, right?
    - Was it a rum by any chance?
    correctQuestion: 3
  - CustomerQuestion: Yes! It had a very fruity taste to it, do you have anything
      with a dark look in stock?
    PlayerQuestions:
    - Maybe it was a citrusy white wine?
    - That'd probably be a red wine then
    - Maybe it was a forest berries wine?
    - Are you SURE it wasn't a rum?
    correctQuestion: 2
  - CustomerQuestion: Yes that sounds about right! Does your commoner shop have what
      you've very clumsily described?
    PlayerQuestions:
    - We have this nice charonnay called Fresco, I could grab that for you
    - 'We have a rose called Romantic, I can get it for you '
    - Are you absolutely sure it wasn't a rum?
    - We have a lovely caberimet sauvignon called Brights, I'll go fetch that for
      you
    correctQuestion: 4
  dialogueOptions:
  - {fileID: 1547138238}
  - {fileID: 1224694489}
  - {fileID: 1478521138}
  - {fileID: 523277091}
  currentCustomerQuestion: 0
  questionText: {fileID: 1683128340}
  incorrectResponse: No that doesn't seem right at all! I would NEVER drink filth
    like that! Are you sure you know what you're doing?
